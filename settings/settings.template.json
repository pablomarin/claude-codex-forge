{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Edit(./.forge/local/**)",
      "Edit(**/.forge/local/**)",
      "Bash",
      "Bash(codex:*)",
      "Bash(rm -rf .mypy_cache)",
      "Bash(rm -rf .pytest_cache)",
      "Bash(rm -rf .ruff_cache)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "mcp__context7",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Edit(~/.forge/bin/**)",
      "Bash(*.forge/bin*:*)",
      "Read(~/.forge/goal-captures/**)",
      "Edit(~/.forge/goal-captures/**)",
      "Edit(~/.forge/goal-authorizations/**)",
      "Bash(*.forge/goal-captures*:*)",
      "Bash(*.forge/goal-authorizations*:*)",
      "Bash(*forge-goal-authorize*:*)",
      "Bash(*forge-goal-capture*:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.forge/goal-captures"],
      "denyWrite": ["~/.forge/bin", "~/.forge/goal-captures", "~/.forge/goal-authorizations"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "host-context",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/lib/host-context.sh\" hook --host claude"
          },
          {
            "type": "command",
            "forgeManagedId": "session-start",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "host-context",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/lib/host-context.sh\" hook --host claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "build-evidence",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/build-evidence.sh"
          },
          {
            "type": "command",
            "forgeManagedId": "state-updated",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-state-updated.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^forge-v6-producer$",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "subagent-review-receipt",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-subagent-review.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "precompact-memory",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/pre-compact-memory.sh"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "config-change",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-config-change.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "bash-safety",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-bash-safety.sh"
          },
          {
            "type": "command",
            "forgeManagedId": "workflow-gates",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-workflow-gates.sh"
          },
          {
            "type": "command",
            "forgeManagedId": "external-mutation-auth",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/check-external-mutation-auth.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "auto-approve-local",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/auto-approve-local-writes.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "post-format",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/post-tool-format.sh"
          }
        ]
      }
    ]
  }
}
