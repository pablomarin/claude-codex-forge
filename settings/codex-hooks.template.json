{
  "description": "Forge v6 project hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/host-context.sh\" hook --host codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\host-context.ps1') -Mode hook -Host codex\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" session-start.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook session-start.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/host-context.sh\" hook --host codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\host-context.ps1') -Mode hook -Host codex\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" check-bash-safety.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook check-bash-safety.ps1\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" check-workflow-gates.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook check-workflow-gates.ps1\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" check-external-mutation-auth.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook check-external-mutation-auth.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" post-tool-format.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook post-tool-format.ps1\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "forge-v6-producer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" check-subagent-review.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook check-subagent-review.ps1\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" pre-compact-memory.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook pre-compact-memory.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" build-evidence.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook build-evidence.ps1\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.forge/hooks/lib/codex-worktree-dispatch.sh\" check-state-updated.sh",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.forge\\hooks\\lib\\codex-worktree-dispatch.ps1') -Hook check-state-updated.ps1\""
          }
        ]
      }
    ]
  }
}
