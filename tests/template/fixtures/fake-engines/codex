#!/usr/bin/env bash
set -u
log="${FAKE_CODEX_LOG:-}"
[ -z "$log" ] || printf 'cwd=%s home=%s argv=%s\n' "$(pwd -P)" "${HOME:-}" "$*" >> "$log"
out=""
joined="$*"
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--output-last-message" ] && [ "$#" -gt 1 ]; then out="$2"; shift 2; else shift; fi
done
[ -z "${FORGE_DISPATCH_SESSION_ID:-}" ] || case "$joined" in
  *'exec resume '*) ;;
  *'--json'*) printf '{"type":"thread.started","thread_id":"%s"}\n' "$FORGE_DISPATCH_SESSION_ID" ;;
esac
emit() { if [ -n "$out" ]; then printf '%s\n' "$@" > "$out"; else printf '%s\n' "$@"; fi; }
clean_envelope() {
  emit 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' \
    "forge_canary_hash=${FORGE_DISPATCH_CANARY_HASH:-MISSING}" \
    "forge_config_hash=${FORGE_DISPATCH_CONFIG_HASH:-MISSING}" \
    "forge_qualification_revision=${FORGE_DISPATCH_QUALIFICATION_REVISION:-MISSING}"
}
qualified_envelope() {
  emit "$@" "forge_canary_hash=${FORGE_DISPATCH_CANARY_HASH:-MISSING}" "forge_config_hash=${FORGE_DISPATCH_CONFIG_HASH:-MISSING}" "forge_qualification_revision=${FORGE_DISPATCH_QUALIFICATION_REVISION:-MISSING}"
}
case "${FAKE_CODEX_BEHAVIOR:-clean}" in
  clean) clean_envelope ;;
  permission-denied) printf '%s\n' 'Permission denied by host policy' >&2; exit 1 ;;
  require-proxy)
    for proxy_name in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
      [ "${!proxy_name:-}" = "forge-test-$proxy_name" ] || exit 62
    done
    [ -z "${FORGE_AMBIENT_SECRET:-}${NODE_OPTIONS:-}${ANTHROPIC_BASE_URL:-}" ] || exit 61
    clean_envelope ;;
  require-fast) case " $joined " in *' -c service_tier=fast '*) clean_envelope ;; *) exit 63 ;; esac ;;
  findings) qualified_envelope 'schema_version=1' 'verdict=FINDINGS' 'max_severity=P1' 'blocked_class=none' 'finding=F-1|P1|reachable defect' ;;
  findings-p3) qualified_envelope 'schema_version=1' 'verdict=FINDINGS' 'max_severity=P3' 'blocked_class=none' 'finding=F-1|P3|open|advisory note' ;;
  contradictory-p3) qualified_envelope 'schema_version=1' 'verdict=FINDINGS' 'max_severity=P3' 'blocked_class=none' 'finding=F-1|P1|open|material defect under false maximum' ;;
  blocked-artifact) qualified_envelope 'schema_version=1' 'verdict=BLOCKED' 'max_severity=NONE' 'blocked_class=artifact' ;;
  blocked-authorization) qualified_envelope 'schema_version=1' 'verdict=BLOCKED' 'max_severity=NONE' 'blocked_class=authorization' ;;
  blocked-engine) qualified_envelope 'schema_version=1' 'verdict=BLOCKED' 'max_severity=NONE' 'blocked_class=engine' ;;
  blocked-unobserved)
    emit 'schema_version=1' 'verdict=BLOCKED' 'max_severity=NONE' 'blocked_class=capability' \
      'forge_canary_hash=unobserved' 'forge_config_hash=unobserved' 'forge_qualification_revision=unobserved' ;;
  clean-unobserved)
    emit 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' \
      'forge_canary_hash=unobserved' 'forge_config_hash=unobserved' 'forge_qualification_revision=unobserved' ;;
  wrong-canary)
    emit 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' \
      'forge_canary_hash=WRONG' "forge_config_hash=${FORGE_DISPATCH_CONFIG_HASH:-MISSING}" \
      "forge_qualification_revision=${FORGE_DISPATCH_QUALIFICATION_REVISION:-MISSING}" ;;
  contradictory) qualified_envelope 'schema_version=1' 'verdict=CLEAN' 'max_severity=P1' 'blocked_class=none' 'finding=F-1|P1|contradiction' ;;
  malformed) emit 'This is prose, not an envelope.' ;;
  empty) [ -z "$out" ] || : > "$out" ;;
  exit) exit 23 ;;
  timeout) sleep 30 ;;
  delayed-clean) sleep 1; clean_envelope ;;
  investigate)
    mkdir -p "$FORGE_CANDIDATE_ROOT/tests/reproductions"
    printf 'bounded reproduction\n' > "$FORGE_CANDIDATE_ROOT/tests/reproductions/claimed.txt"
    qualified_envelope 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' 'replay_path=tests/reproductions/claimed.txt' ;;
  full-investigation)
    real_root=$(cd "${FAKE_REAL_ROOT:?}" && pwd -P)
    [ "$(pwd -P)" = "$real_root" ] || exit 71
    [ "${FORGE_FULL_AGENT_PROBE:-}" = visible ] || exit 72
    [ "${FORGE_INVESTIGATION_CHILD:-}" = 1 ] || exit 75
    grep -q 'shared durable memory' "$real_root/.forge/memory/shared.md" || exit 73
    grep -q 'shared local memory' "$real_root/.forge/local/memory/session.md" || exit 74
    mkdir -p "$real_root/.forge/local/investigation-artifacts"
    printf 'codex full agent\n' > "$real_root/.forge/local/investigation-artifacts/codex.txt"
    clean_envelope ;;
  repro)
    [ -z "${FORGE_REPRO_RUNNER:-}" ] || "$FORGE_REPRO_RUNNER"
    qualified_envelope 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' 'hypothesis_hash=hypothesis-literal' 'primary_check_hash=primary-literal' 'control_hash=control-literal' 'primary_status=EXPECTED' 'control_status=EXPECTED' 'repro_status=REPRODUCED' ;;
  repro-no-control)
    qualified_envelope 'schema_version=1' 'verdict=CLEAN' 'max_severity=NONE' 'blocked_class=none' 'hypothesis_hash=hypothesis-literal' 'primary_check_hash=primary-literal' 'control_hash=MISSING' 'primary_status=EXPECTED' 'control_status=MISSING' 'repro_status=REPRODUCED' ;;
  repro-boundary)
    case "$joined" in *'--sandbox workspace-write'*) ;; *) exit 69 ;; esac
    [ -n "${FORGE_REPRO_RUNNER:-}" ] && [ -x "$FORGE_REPRO_RUNNER" ] || exit 70
    FORGE_REPRO_NO_NETWORK=1 "$FORGE_REPRO_RUNNER"
    clean_envelope ;;
  require-auth)
    [ -s "${CODEX_HOME:-}/auth.json" ] || exit 68
    clean_envelope ;;
  mutate-malformed)
    : > "${FORGE_CANDIDATE_ROOT:?}/fallback-dirty"
    emit 'prose only' ;;
  *) exit 64 ;;
esac
[ -z "${FAKE_MUTATE_REAL:-}" ] || printf 'raced\n' >> "$FAKE_MUTATE_REAL"
